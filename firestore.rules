rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lousa pessoal (como já era): cada um só enxerga o que está em users/{uid}
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Lousas compartilhadas
    match /shared/{sid} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.members;

      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      allow update: if request.auth != null && (
        // participantes editam (a dona/o dono nunca muda)
        ( request.auth.uid in resource.data.members
          && request.resource.data.ownerUid == resource.data.ownerUid )
        ||
        // convidado aceitando ou recusando: só mexe nas listas de pessoas e só entra ele mesmo
        ( request.auth.token.email.lower() in resource.data.invitedEmails
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberEmails', 'invitedEmails'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet())
               .hasOnly([request.auth.uid]) )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      // sinalização do Pong online (só participantes da lousa)
      match /rtc/{rid} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/shared/$(sid)).data.members;
      }

      match /images/{imgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/shared/$(sid)).data.members;
      }
    }

    // Pedidos de compartilhamento
    match /invites/{inviteId} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow read, update: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toEmail == request.auth.token.email.lower()
      );
    }
  }
}
